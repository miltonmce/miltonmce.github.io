---
import Layout from "../layouts/Layout.astro";
import SkillBlock from "../components/SkillBlock.astro";
---

<Layout
  title="CV — Milton Medina | Backend Engineer"
  description="Currículum vitae de Milton Medina, consultor en desarrollo backend, arquitectura de sistemas y automatización."
  isHome={false}
>
  <div class="cv-page">
    <header class="cv-header">
      <div class="cv-identity">
        <div class="cv-monogram" aria-hidden="true">MM</div>
        <div class="cv-identity-text">
          <span class="eyebrow">Curriculum vitae</span>
          <h1>Milton Medina</h1>
          <p class="cv-role">
            Consultor freelance en desarrollo backend y arquitectura de sistemas
          </p>
          <p class="cv-location">
            <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
            México · Trabajo remoto
          </p>
        </div>
      </div>

      <div class="cv-actions">
        <a href="mailto:miltonmce@gmail.com" class="btn btn-primary btn-sm">
          <i class="fa-regular fa-envelope" aria-hidden="true"></i>
          Email
        </a>
        <a
          href="https://github.com/miltonmce"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-ghost btn-sm"
        >
          <i class="fa-brands fa-github" aria-hidden="true"></i>
          GitHub
        </a>
        <a
          href="https://www.linkedin.com/in/milton-medina-134694a4/"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-ghost btn-sm"
        >
          <i class="fa-brands fa-linkedin-in" aria-hidden="true"></i>
          LinkedIn
        </a>
      </div>
    </header>

    <section class="cv-section" id="perfil">
      <h2><i class="fa-solid fa-user-tie" aria-hidden="true"></i> Perfil profesional</h2>
      <p>
        Consultor independiente especializado en Python y Django, enfocado en el
        diseño y desarrollo de sistemas robustos para la gestión de datos
        técnicos, reglas de negocio complejas y automatización de procesos.
      </p>
      <p class="cv-emphasis">
        <strong>Actualmente lidero:</strong> Sistema Integral de Gestión Hídrica
        (administración de 800+ pozos activos con reglas de negocio complejas,
        validaciones críticas y reportes de alto volumen).
      </p>
      <p><strong>Ayudo a empresas y organizaciones a:</strong></p>
      <div class="cv-highlights">
        <div class="highlight">
          <ul>
            <li>Convertir procesos manuales en sistemas digitales estructurados</li>
            <li>Modelar reglas de negocio complejas sin perder consistencia</li>
            <li>Optimizar bases de datos con grandes volúmenes de información</li>
          </ul>
        </div>
        <div class="highlight">
          <ul>
            <li>Implementar validaciones críticas para evitar errores operativos</li>
            <li>Diseñar plataformas escalables y mantenibles</li>
            <li>Trabajar bajo principios de arquitectura limpia</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="cv-section" id="experiencia">
      <h2><i class="fa-solid fa-briefcase" aria-hidden="true"></i> Experiencia profesional</h2>
      <div class="timeline">
        <div class="timeline-item">
          <div class="timeline-date">Enero 2024 – Presente</div>
          <div class="timeline-title">Consultor y desarrollador principal</div>
          <div class="timeline-subtitle">
            Sistema Integral de Gestión Hídrica · 1 año
          </div>
          <p>
            Lidero el desarrollo integral de una plataforma especializada en la
            gestión técnica y jurídica de recursos hídricos. Diseño y desarrollo
            de arquitectura basada en reglas explícitas de negocio, administrando
            800+ pozos activos con validaciones críticas. Implementación de
            modelado complejo (volumen autorizado, disponible y transferido),
            arrendamientos en cascada, transferencias temporales automáticas y
            generación de reportes de alto volumen con integridad de datos
            garantizada.
          </p>
        </div>

        <div class="timeline-item">
          <div class="timeline-date">Feb. 2016 – Presente</div>
          <div class="timeline-title">Consultor freelance — Desarrollo backend</div>
          <div class="timeline-subtitle">Autoempleado · 10+ años</div>
          <p>
            Consultoría especializada en diseño y desarrollo de sistemas backend
            con Python y Django. Experiencia en gestión de datos técnicos
            complejos, reglas de negocio estrictas, optimización de bases de
            datos PostgreSQL y automatización de procesos críticos. Trabajo
            directo con empresas mexicanas en el desarrollo de plataformas
            escalables y mantenibles.
          </p>
        </div>

        <div class="timeline-item">
          <div class="timeline-date">Dic. 2017 – Ene. 2019</div>
          <div class="timeline-title">Líder de proyecto</div>
          <div class="timeline-subtitle">Corcab · 1 año 2 meses</div>
          <p>
            Gestión y desarrollo de aplicaciones web empresariales usando Python
            2.7.X con web2py Framework. Implementación de APIs REST,
            arquitectura con componentes y microservicios, facturación
            electrónica con Timbox, generación de reportes avanzados con PyFPDF.
            Levantamiento de requerimientos, documentación UML y coordinación de
            equipos técnicos.
          </p>
        </div>
      </div>
    </section>

    <section class="cv-section" id="habilidades">
      <h2><i class="fa-solid fa-code" aria-hidden="true"></i> Habilidades técnicas</h2>
      <div class="skills-grid">
        <SkillBlock
          title="Desarrollo backend & datos"
          tags={[
            "Python (2.7 - 3.13)",
            "Django & REST Framework",
            "SQL (PostgreSQL / MySQL)",
            "Diseño de Bases de Datos",
            "Modelado de Reglas de Negocio",
          ]}
        />

        <SkillBlock
          title="Automatización & stack industrial"
          tags={[
            "Integración Modbus TCP/RTU",
            "MQTT",
            "Node-RED",
            "Telemetría IIoT",
            "Monitoreo de Pozos / PLCs",
          ]}
        />

        <SkillBlock
          title="Infraestructura & deployment"
          tags={[
            "Linux (Fedora / Debian / Ubuntu)",
            "Docker & Compose",
            "Bash Scripting",
            "Nginx",
            "Podman",
            "SSH & Túneles Seguros",
          ]}
        />

        <SkillBlock
          title="Herramientas & entorno"
          tags={["Git / GitHub", "VS Code", "PyCharm", "Postman", "WSL2", "CI / CD"]}
        />

        <SkillBlock
          title="Frontend & UI"
          tags={["HTMX", "JavaScript (ES6+)", "Bootstrap", "Tailwind CSS", "Astro"]}
        />
      </div>
    </section>

    <section class="cv-section" id="proyectos">
      <h2><i class="fa-solid fa-diagram-project" aria-hidden="true"></i> Proyectos destacados</h2>

      <div class="featured-project">
        <div class="project-header-featured">
          <h3>Sistema Integral de Gestión Hídrica</h3>
          <span class="project-date">Enero 2024 – Presente</span>
        </div>
        <p class="project-role">
          <strong>Consultor y desarrollador principal</strong>
        </p>

        <p class="project-description">
          Lidero el desarrollo de una plataforma especializada en la gestión
          técnica y jurídica de recursos hídricos, optimizando la administración
          de más de 800 pozos activos y sus operaciones asociadas.
        </p>

        <h4 class="impact-title">
          <i class="fa-solid fa-star" aria-hidden="true"></i> Impacto y resultados
        </h4>
        <ul class="impact-list">
          <li>
            <strong>Digitalización completa</strong> de procesos previamente
            manuales, reduciendo errores operativos y administrativos.
          </li>
          <li>
            <strong>Modelado de reglas de negocio complejas</strong> para control
            de volumen autorizado, disponible y transferido, evitando
            inconsistencias críticas.
          </li>
          <li>
            <strong>Arrendamientos en cascada</strong> con trazabilidad
            estructurada y validaciones automáticas.
          </li>
          <li>
            <strong>Sistema de transferencias temporales</strong> que previene
            saldos negativos o sobreasignaciones.
          </li>
          <li>
            <strong>Optimización de consultas SQL</strong> para generación rápida
            de reportes técnicos y jurídicos de alto volumen.
          </li>
          <li>
            <strong>Automatización de reportes Excel</strong> con cálculos
            consolidados, agrupaciones y validaciones integradas.
          </li>
          <li>
            <strong>Mejora en integridad de datos</strong> crítica para toma de
            decisiones administrativas y cumplimiento normativo.
          </li>
        </ul>

        <h4 class="technical-title">
          <i class="fa-solid fa-gear" aria-hidden="true"></i> Enfoque técnico
        </h4>
        <p>
          Arquitectura basada en reglas explícitas de negocio, priorizando
          integridad de datos, escalabilidad, claridad en el dominio y
          trazabilidad histórica de operaciones.
        </p>

        <div class="tech-stack-featured">
          <span>Python</span>
          <span>Django</span>
          <span>Django REST Framework</span>
          <span>PostgreSQL</span>
          <span>HTMX</span>
          <span>openpyxl</span>
          <span>pandas</span>
        </div>
      </div>
    </section>

    <section class="cv-section" id="servicios">
      <h2><i class="fa-solid fa-handshake" aria-hidden="true"></i> Servicios de consultoría</h2>

      <div class="services-list">
        <div class="service-item">
          <h3>Desarrollo backend a medida</h3>
          <p>
            Sistemas en Django y Django REST Framework · APIs seguras con
            autenticación JWT · Código mantenible y modular · Modelado de
            relaciones complejas.
          </p>
        </div>

        <div class="service-item">
          <h3>Optimización y refactorización</h3>
          <p>
            Refactorización de proyectos Django · Optimización de consultas SQL y
            ORM · Corrección de inconsistencias lógicas · Mejora de rendimiento
            en reportes pesados.
          </p>
        </div>

        <div class="service-item">
          <h3>Sistemas de gestión técnica</h3>
          <p>
            Gestión de más de 800 entidades técnicas activas · Control de
            volúmenes autorizados, disponibles y transferidos · Arrendamientos y
            subarrendamientos en cascada · Transferencias temporales con
            validación automática.
          </p>
        </div>

        <div class="service-item">
          <h3>Automatización y reportes avanzados</h3>
          <p>
            Generación avanzada de reportes en Excel (openpyxl) · Procesamiento
            de datos con pandas · Agrupaciones, totales y validaciones
            automáticas · Tareas programadas con django-crontab.
          </p>
        </div>

        <div class="service-item">
          <h3>Integración con hardware y sistemas externos</h3>
          <p>
            Integración Modbus · Conexión entre sistemas físicos y plataformas
            web · Sincronización de datos en tiempo real.
          </p>
        </div>

        <div class="service-item">
          <h3>Asesoría arquitectónica</h3>
          <p>
            Diseño de arquitectura escalable · Análisis profundo del dominio del
            negocio · Estrategia a largo plazo · Evaluación de alternativas
            técnicas.
          </p>
        </div>
      </div>
    </section>

    <section class="cv-section" id="certificaciones">
      <h2><i class="fa-solid fa-certificate" aria-hidden="true"></i> Certificaciones y educación</h2>
      <div class="certifications-list">
        <div class="cert-item">
          <h3>Ethical Hacking</h3>
          <p class="cert-issuer">mKit IT & Security Solutions</p>
          <p>Curso gratuito de Ethical Hacking. Certificación de asistencia completa.</p>
        </div>

        <div class="cert-item">
          <h3>Oracle Certified Java Programmer SE 6</h3>
          <p class="cert-issuer">Oracle</p>
          <p>Certificación profesional en Java.</p>
        </div>

        <div class="cert-item">
          <h3>Educación continua — SharePoint Office 365</h3>
          <p class="cert-issuer">Develop Talent & Technology</p>
          <p>
            Agradecimiento de educación continua por el curso SharePoint Office
            365 como instructor auxiliar.
          </p>
        </div>

        <div class="cert-item">
          <h3>Colaboración — Curso web2py</h3>
          <p class="cert-issuer">Latinux & Semnix</p>
          <p>Colaboración en el desarrollo del curso web2py para Latinux y Semnix.</p>
        </div>

        <div class="cert-item">
          <h3>Investigación doctoral</h3>
          <p class="cert-issuer">Colaboración académica</p>
          <p>Colaboración en investigación doctoral sobre integridad de datos.</p>
        </div>
      </div>
    </section>

    <section class="cv-section download-section">
      <div>
        <h2><i class="fa-solid fa-file-arrow-down" aria-hidden="true"></i> Lleva mi CV contigo</h2>
        <p>Descarga una versión en PDF lista para compartir o imprimir.</p>
      </div>
      <button onclick="generatePDF()" class="btn btn-primary" type="button">
        <i class="fa-solid fa-download" aria-hidden="true"></i>
        Descargar CV en PDF
      </button>
    </section>
  </div>
</Layout>

<style>
  .cv-page {
    width: min(1000px, 100% - 3rem);
    margin-inline: auto;
    padding: 2.5rem 0 5rem;
  }

  /* Header */
  .cv-header {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 1.25rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(600px 260px at 85% 0%, rgba(var(--accent-2-rgb), 0.12), transparent 65%),
      radial-gradient(500px 260px at 0% 100%, rgba(var(--accent-rgb), 0.08), transparent 65%),
      var(--card-solid);
  }

  .cv-header::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(148, 163, 184, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(148, 163, 184, 0.04) 1px, transparent 1px);
    background-size: 40px 40px;
    mask-image: radial-gradient(ellipse 80% 100% at 50% 0%, #000, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 80% 100% at 50% 0%, #000, transparent 80%);
    pointer-events: none;
  }

  .cv-identity,
  .cv-actions {
    position: relative;
    z-index: 1;
  }

  .cv-identity {
    display: flex;
    align-items: center;
    gap: 1.4rem;
  }

  .cv-monogram {
    display: grid;
    place-items: center;
    flex: 0 0 76px;
    width: 76px;
    height: 76px;
    border-radius: 20px;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: #041016;
    font-family: var(--font-mono);
    font-size: 1.35rem;
    font-weight: 700;
    box-shadow: 0 18px 40px -18px rgba(var(--accent-rgb), 0.8);
  }

  .cv-identity .eyebrow {
    margin-bottom: 0.35rem;
  }

  .cv-identity h1 {
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    line-height: 1;
  }

  .cv-role {
    margin-top: 0.5rem;
    color: var(--text-soft);
    font-size: 0.95rem;
  }

  .cv-location {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.5rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .cv-location i {
    color: var(--accent);
  }

  .cv-actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.4rem;
    min-width: 148px;
    justify-content: flex-end;
  }

  .cv-actions .btn {
    justify-content: flex-start;
  }

  /* Sections */
  .cv-section {
    margin-bottom: 1.25rem;
    padding: clamp(1.35rem, 3vw, 2rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--card);
  }

  .cv-section h2 {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 1.25rem;
    font-size: 1.3rem;
  }

  .cv-section h2 i {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid rgba(var(--accent-rgb), 0.2);
    border-radius: 9px;
    background: rgba(var(--accent-rgb), 0.07);
    color: var(--accent);
    font-size: 0.78rem;
  }

  .cv-section p {
    color: var(--text-soft);
    font-size: 0.94rem;
    line-height: 1.75;
    margin-bottom: 0.8rem;
  }

  .cv-section p:last-child {
    margin-bottom: 0;
  }

  .cv-emphasis {
    padding: 0.9rem 1rem;
    border: 1px solid rgba(var(--accent-rgb), 0.14);
    border-left: 2px solid var(--accent);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    background: rgba(var(--accent-rgb), 0.045);
  }

  .cv-emphasis strong {
    color: var(--text);
  }

  /* Highlights */
  .cv-highlights {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }

  .highlight {
    padding: 1rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.02);
  }

  .highlight ul {
    list-style: none;
  }

  .highlight li {
    position: relative;
    padding: 0.35rem 0 0.35rem 1.2rem;
    color: var(--text-soft);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .highlight li::before {
    content: "▸";
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  /* Timeline */
  .timeline {
    position: relative;
    padding-left: 1.75rem;
  }

  .timeline::before {
    content: "";
    position: absolute;
    left: 5px;
    top: 0.35rem;
    bottom: 0.35rem;
    width: 1px;
    background: linear-gradient(var(--accent), var(--line));
  }

  .timeline-item {
    position: relative;
    padding-bottom: 1.75rem;
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-item::before {
    content: "";
    position: absolute;
    left: -1.75rem;
    top: 0.35rem;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
    box-shadow: 0 0 0 3px rgba(var(--accent-rgb), 0.1);
  }

  .timeline-date {
    margin-bottom: 0.15rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
  }

  .timeline-title {
    font-family: var(--font-display);
    font-size: 1.08rem;
    font-weight: 600;
    color: var(--text);
  }

  .timeline-subtitle {
    margin-bottom: 0.5rem;
    color: var(--accent);
    font-size: 0.84rem;
    font-weight: 500;
  }

  .timeline-item p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.7;
  }

  /* Skills */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .skills-grid :global(.skill-block:last-child) {
    grid-column: 1 / -1;
  }

  /* Featured project */
  .featured-project {
    padding: clamp(1.15rem, 3vw, 1.75rem);
    border: 1px solid rgba(var(--accent-rgb), 0.16);
    border-radius: var(--radius);
    background:
      linear-gradient(135deg, rgba(var(--accent-rgb), 0.05), rgba(var(--accent-2-rgb), 0.05)),
      rgba(9, 13, 20, 0.6);
  }

  .project-header-featured {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.35rem;
  }

  .project-header-featured h3 {
    font-size: 1.2rem;
  }

  .project-date {
    flex: 0 0 auto;
    padding: 0.3rem 0.65rem;
    border: 1px solid rgba(var(--accent-rgb), 0.22);
    border-radius: 999px;
    background: rgba(var(--accent-rgb), 0.07);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    white-space: nowrap;
  }

  .project-role {
    margin-bottom: 0.9rem !important;
    color: var(--accent-2) !important;
    font-size: 0.82rem !important;
  }

  .project-description {
    font-size: 0.92rem !important;
  }

  .impact-title,
  .technical-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 1.4rem 0 0.75rem;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
  }

  .impact-title i,
  .technical-title i {
    color: var(--accent);
    font-size: 0.8rem;
  }

  .impact-list {
    display: grid;
    gap: 0.55rem;
    list-style: none;
  }

  .impact-list li {
    position: relative;
    padding-left: 1.2rem;
    color: var(--text-soft);
    font-size: 0.88rem;
    line-height: 1.6;
  }

  .impact-list li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .impact-list strong {
    color: var(--text);
  }

  .tech-stack-featured {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.25rem;
  }

  .tech-stack-featured span {
    padding: 0.32rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-soft);
    font-size: 0.76rem;
  }

  /* Services */
  .services-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .service-item {
    padding: 1rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.02);
  }

  .service-item h3 {
    margin-bottom: 0.4rem;
    font-size: 0.94rem;
  }

  .service-item p {
    font-size: 0.85rem;
    line-height: 1.65;
    margin: 0;
  }

  /* Certifications */
  .certifications-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .cert-item {
