<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

<script is:inline>
  function generatePDF() {
    const original = document.querySelector(".cv-page");
    if (!original || typeof html2pdf === "undefined") return;

    const clone = original.cloneNode(true);
    clone.classList.add("pdf-mode");

    const holder = document.createElement("div");
    holder.className = "pdf-holder";
    holder.appendChild(clone);

    const overlay = document.createElement("div");
    overlay.className = "pdf-overlay";
    overlay.innerHTML =
      '<div class="pdf-overlay-card"><i class="fa-solid fa-circle-notch fa-spin"></i><span>Generando PDF…</span></div>';

    document.body.appendChild(holder);
    document.body.appendChild(overlay);

    const root = document.documentElement;
    const previousScrollBehavior = root.style.scrollBehavior;
    const previousScroll = window.scrollY;

    root.style.scrollBehavior = "auto";
    window.scrollTo(0, 0);

    const cleanup = () => {
      holder.remove();
      overlay.remove();
      window.scrollTo(0, previousScroll);
      root.style.scrollBehavior = previousScrollBehavior;
    };

    const options = {
      margin: [8, 8, 8, 8],
      filename: "CV-Milton-Medina.pdf",
      image: { type: "jpeg", quality: 0.98 },
      html2canvas: {
        scale: 2,
        useCORS: true,
        logging: false,
        letterRendering: true,
        backgroundColor: "#ffffff",
      },
      jsPDF: {
        unit: "mm",
        format: "a4",
        orientation: "portrait",
      },
    };

    requestAnimationFrame(() => {
      html2pdf()
        .set(options)
        .from(clone)
        .save()
        .then(cleanup)
        .catch((error) => {
          console.error("No se pudo generar el PDF", error);
          cleanup();
        });
    });
  }
</script>
