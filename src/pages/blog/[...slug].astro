---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const blogEntries = await getCollection("blog");
  return blogEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const rendered = await entry.render();
const { Content } = rendered;

const formattedDate = entry.data.date.toLocaleDateString("es-ES", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const wordCount = entry.body ? entry.body.split(/\s+/).length : 0;
const readingTime = Math.ceil(wordCount / 200) || 1;
---

<Layout
  title={entry.data.title}
  description={entry.data.description}
  isHome={false}
>
  <div class="reading-progress" aria-hidden="true"><span></span></div>

  <article class="blog-post">
    <a href="/blog" class="back-link">
      <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
      Volver al blog
    </a>

    <header class="post-header" data-reveal>
      <div class="post-meta">
        <time class="post-date" datetime={entry.data.date.toISOString()}>
          <i class="fa-regular fa-calendar" aria-hidden="true"></i>
          {formattedDate}
        </time>
        <span class="reading-time">
          <i class="fa-regular fa-clock" aria-hidden="true"></i>
          {readingTime} min de lectura
        </span>
      </div>

      <h1 class="post-title">{entry.data.title}</h1>
      <p class="post-subtitle">{entry.data.description}</p>

      <div class="post-tags">
        {entry.data.tags.map((tag) => <span class="chip">{tag}</span>)}
      </div>
    </header>

    <div class="prose">
      <Content />
    </div>

    <footer class="post-footer">
      <div class="author-card">
        <div class="author-mark" aria-hidden="true">MM</div>
        <div>
          <span class="author-label">Escrito por</span>
          <strong>Milton Medina</strong>
          <p>
            Consultor backend especializado en Python, Django y sistemas de
            misión crítica.
          </p>
        </div>
      </div>

      <div class="post-cta">
        <div class="post-cta-copy">
          <span class="eyebrow">¿Te resultó útil?</span>
          <h2>Hablemos de tu proyecto</h2>
          <p>
            Si estás frente a un problema técnico complejo, puedo ayudarte a
            diseñar una solución clara y sostenible.
          </p>
        </div>
        <div class="post-cta-actions">
          <a
            href="mailto:miltonmce@gmail.com?subject=Consulta%20desde%20el%20blog"
            class="btn btn-primary"
          >
            <i class="fa-regular fa-paper-plane" aria-hidden="true"></i>
            Contactarme
          </a>
          <a href="/blog" class="btn btn-ghost">
            Más artículos
            <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
          </a>
        </div>
      </div>
    </footer>
  </article>
</Layout>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 200;
    width: 100%;
    height: 2px;
    background: transparent;
    pointer-events: none;
  }

  .reading-progress span {
    display: block;
    width: 0;
    height: 100%;
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    box-shadow: 0 0 12px rgba(var(--accent-rgb), 0.6);
    transition: width 0.1s linear;
  }

  .blog-post {
    width: min(800px, 100% - 3rem);
    margin-inline: auto;
    padding: clamp(2rem, 5vw, 3.5rem) 0 5rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-decoration: none;
    transition: var(--transition);
  }

  .back-link:hover {
    color: var(--accent);
    transform: translateX(-3px);
  }

  .post-header {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--line);
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .post-date,
  .reading-time {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .post-date i,
  .reading-time i {
    color: var(--accent);
    font-size: 0.72rem;
  }

  .post-title {
    font-size: clamp(2rem, 4.8vw, 3.1rem);
    line-height: 1.1;
  }

  .post-subtitle {
    margin-top: 1rem;
    color: var(--text-soft);
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.4rem;
  }

  /* Prose */
  .prose {
    font-size: 1rem;
    line-height: 1.85;
    color: var(--text-soft);
  }

  .prose :global(h1) {
    display: none;
  }

  .prose :global(h2) {
    margin: 2.6rem 0 1rem;
    padding-left: 0.9rem;
    border-left: 2px solid var(--accent);
    font-size: clamp(1.4rem, 2.6vw, 1.8rem);
    line-height: 1.25;
    scroll-margin-top: calc(var(--nav-height) + 2rem);
  }

  .prose :global(h3) {
    margin: 2rem 0 0.7rem;
    font-size: 1.22rem;
    scroll-margin-top: calc(var(--nav-height) + 2rem);
  }

  .prose :global(h4) {
    margin: 1.6rem 0 0.6rem;
    font-size: 1.05rem;
    color: var(--text);
  }

  .prose :global(p) {
    margin-bottom: 1.35rem;
  }

  .prose :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  .prose :global(a) {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid rgba(var(--accent-rgb), 0.3);
    transition: var(--transition);
  }

  .prose :global(a:hover) {
    border-bottom-color: var(--accent);
    background: rgba(var(--accent-rgb), 0.07);
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 1.25rem 0 1.5rem 1.4rem;
  }

  .prose :global(li) {
    margin-bottom: 0.55rem;
    padding-left: 0.2rem;
  }

  .prose :global(li::marker) {
    color: var(--accent);
  }

  .prose :global(blockquote) {
    margin: 1.75rem 0;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--line);
    border-left: 2px solid var(--accent-2);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    background: rgba(var(--accent-2-rgb), 0.05);
    color: var(--text-soft);
    font-style: italic;
  }

  .prose :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .prose :global(code) {
    padding: 0.18em 0.4em;
    border: 1px solid var(--line);
    border-radius: 5px;
    background: rgba(var(--accent-rgb), 0.08);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.86em;
  }

  .prose :global(pre) {
    margin: 1.75rem 0;
    padding: 1.25rem 1.35rem;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.025), transparent 30%),
      #080b11;
    box-shadow: var(--shadow-sm);
    line-height: 1.65;
  }

  .prose :global(pre code) {
    padding: 0;
    border: 0;
    background: none;
    color: #cbd5e1;
    font-size: 0.85rem;
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
    margin: 1.75rem auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .prose :global(figure) {
    margin: 1.75rem 0;
  }

  .prose :global(figcaption) {
    margin-top: 0.6rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-align: center;
  }

  .prose :global(hr) {
    margin: 2.5rem 0;
    border: 0;
    border-top: 1px solid var(--line);
  }

  .prose :global(table) {
    width: 100%;
    margin: 1.75rem 0;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 0.7rem 0.85rem;
    border-bottom: 1px solid var(--line);
    text-align: left;
  }

  .prose :global(th) {
    background: rgba(255, 255, 255, 0.03);
    color: var(--text);
    font-weight: 600;
  }

  /* Footer */
  .post-footer {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .author-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--card);
  }

  .author-mark {
    display: grid;
    place-items: center;
    flex: 0 0 48px;
    width: 48px;
    height: 48px;
    border-radius: 13px;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: #041016;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .author-label {
    display: block;
    margin-bottom: 0.1rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .author-card strong {
    font-family: var(--font-display);
    font-size: 1rem;
  }

  .author-card p {
    margin-top: 0.25rem;
    color: var(--text-muted);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .post-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 1rem;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    border: 1px solid rgba(var(--accent-rgb), 0.18);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(130deg, rgba(var(--accent-rgb), 0.07), rgba(var(--accent-2-rgb), 0.07)),
      var(--card-solid);
  }

  .post-cta h2 {
    margin-bottom: 0.4rem;
    font-size: clamp(1.3rem, 3vw, 1.7rem);
  }

  .post-cta p {
    max-width: 440px;
    color: var(--text-soft);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .post-cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    flex: 0 0 auto;
  }

  @media (max-width: 760px) {
    .post-cta {
      flex-direction: column;
      align-items: flex-start;
    }

    .post-cta-actions {
      width: 100%;
    }

    .post-cta-actions .btn {
      flex: 1;
    }
  }

  @media (max-width: 480px) {
    .post-cta-actions {
      flex-direction: column;
    }
  }
</style>

<script>
  const progress = document.querySelector(".reading-progress span");

  const updateProgress = () => {
    const doc = document.documentElement;
    const scrollable = doc.scrollHeight - window.innerHeight;
    const percentage = scrollable > 0 ? (window.scrollY / scrollable) * 100 : 0;
    if (progress) progress.style.width = `${Math.min(percentage, 100)}%`;
  };

  window.addEventListener("scroll", updateProgress, { passive: true });
  window.addEventListener("resize", updateProgress, { passive: true });
  updateProgress();
</script>
