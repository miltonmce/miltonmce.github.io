---
import Layout from "../layouts/Layout.astro";
import Welcome from "../components/Welcome.astro";
---

<Layout title="Milton Medina — Consultor en Backend y Arquitectura">
  <Welcome />

  <!-- Proyectos -->
  <section class="section case-study" id="proyectos">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Caso de estudio</span>
        <h2 class="section-title">Sistema Integral de Gestión Hídrica</h2>
        <p class="section-lead">
          Una plataforma para administrar el ciclo técnico y jurídico de más de
          800 pozos activos, con reglas de negocio que no admiten errores.
        </p>
      </div>

      <div class="case-grid">
        <div class="case-content card" data-reveal>
          <span class="project-badge">
            <span class="project-badge-dot" aria-hidden="true"></span>
            Proyecto actual · Enero 2024 – Presente
          </span>

          <h3>Plataforma de gestión técnica y jurídica de recursos hídricos</h3>

          <div class="case-block">
            <p class="case-label">Desafío</p>
            <p>
              Administración de más de 800 pozos activos con procesos manuales
              propensos a errores, reglas de negocio complejas de volumen
              autorizado, disponible y transferido, además de reportes técnicos
              y jurídicos de alto volumen.
            </p>
          </div>

          <div class="case-block">
            <p class="case-label">Solución</p>
            <p>
              Plataforma especializada con arquitectura basada en reglas
              explícitas de negocio, integridad de datos, escalabilidad y
              trazabilidad histórica completa.
            </p>
          </div>

          <div class="impact-box">
            <p class="case-label">Impacto logrado</p>
            <ul class="impact-list">
              <li>Digitalización del 100% de los procesos manuales</li>
              <li>Eliminación de inconsistencias críticas en volúmenes</li>
              <li>Validaciones automáticas en transferencias y arrendamientos</li>
              <li>Reportes autogenerados con cálculos consolidados</li>
              <li>Trazabilidad histórica de todas las operaciones</li>
              <li>Integración de datos de campo vía Modbus</li>
            </ul>
          </div>

          <div class="tech-tags" aria-label="Tecnologías utilizadas">
            <span class="chip">Python</span>
            <span class="chip">Django</span>
            <span class="chip">Django REST</span>
            <span class="chip">PostgreSQL</span>
            <span class="chip">Vue.js</span>
            <span class="chip">HTMX</span>
            <span class="chip">openpyxl</span>
            <span class="chip">pandas</span>
          </div>

          <a href="/cv#proyectos" class="case-link">
            Ver más proyectos en el CV
            <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
          </a>
        </div>

        <aside class="case-side" data-reveal style="--reveal-delay: 120ms">
          <div class="stats-card">
            <div class="stat">
              <span class="stat-number">800+</span>
              <span class="stat-label">Pozos gestionados</span>
            </div>
            <div class="stat">
              <span class="stat-number">7</span>
              <span class="stat-label">Validaciones críticas</span>
            </div>
            <div class="stat">
              <span class="stat-number">100%</span>
              <span class="stat-label">Digitalización</span>
            </div>
          </div>

          <div class="flow-card card">
            <div class="flow-head">
              <span class="flow-title">Arquitectura en producción</span>
              <span class="flow-live">
                <span aria-hidden="true"></span>
                Live
              </span>
            </div>

            <ol class="flow-list">
              <li>
                <span class="flow-icon"><i class="fa-solid fa-microchip" aria-hidden="true"></i></span>
                <span>
                  <strong>Campo / PLC</strong>
                  <small>Captura Modbus y MQTT</small>
                </span>
              </li>
              <li>
                <span class="flow-icon"><i class="fa-brands fa-python" aria-hidden="true"></i></span>
                <span>
                  <strong>Django + DRF</strong>
                  <small>Reglas de negocio y API</small>
                </span>
              </li>
              <li>
                <span class="flow-icon"><i class="fa-solid fa-database" aria-hidden="true"></i></span>
                <span>
                  <strong>PostgreSQL</strong>
                  <small>Integridad y trazabilidad</small>
                </span>
              </li>
              <li>
                <span class="flow-icon"><i class="fa-solid fa-file-excel" aria-hidden="true"></i></span>
                <span>
                  <strong>Reportes</strong>
                  <small>openpyxl · pandas</small>
                </span>
              </li>
            </ol>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Servicios -->
  <section class="section services" id="servicios">
    <div class="container">
      <div class="section-head center" data-reveal>
        <span class="eyebrow">Servicios</span>
        <h2 class="section-title">Cómo puedo ayudarte</h2>
        <p class="section-lead">
          Soluciones especializadas para transformar procesos de negocio en
          sistemas claros, medibles y sostenibles.
        </p>
      </div>

      <div class="services-grid">
        <article class="service-card" data-reveal>
          <div class="service-head">
            <span class="icon-tile"><i class="fa-solid fa-code" aria-hidden="true"></i></span>
            <span class="service-number">01</span>
          </div>
          <h3>Desarrollo backend a medida</h3>
          <ul class="service-list">
            <li>Sistemas en Django y Django REST Framework</li>
            <li>APIs seguras con autenticación JWT</li>
            <li>Arquitectura orientada a dominio (DDD)</li>
            <li>Modelado de relaciones complejas</li>
          </ul>
          <span class="service-badge">Especialidad</span>
        </article>

        <article class="service-card" data-reveal style="--reveal-delay: 80ms">
          <div class="service-head">
            <span class="icon-tile"><i class="fa-solid fa-gauge-high" aria-hidden="true"></i></span>
            <span class="service-number">02</span>
          </div>
          <h3>Optimización y refactorización</h3>
          <ul class="service-list">
            <li>Evaluación de sistemas existentes</li>
            <li>Refactorización de código Django</li>
            <li>Optimización de consultas SQL y ORM</li>
            <li>Mejora de rendimiento en reportes</li>
          </ul>
        </article>

        <article class="service-card" data-reveal style="--reveal-delay: 160ms">
          <div class="service-head">
            <span class="icon-tile"><i class="fa-solid fa-diagram-project" aria-hidden="true"></i></span>
            <span class="service-number">03</span>
          </div>
          <h3>Sistemas de gestión técnica</h3>
          <ul class="service-list">
            <li>Gestión de entidades técnicas complejas</li>
            <li>Control de volúmenes y transferencias</li>
            <li>Validaciones automáticas con reglas críticas</li>
            <li>Reportes jurídicos y técnicos</li>
          </ul>
        </article>

        <article class="service-card" data-reveal>
          <div class="service-head">
            <span class="icon-tile"><i class="fa-solid fa-chart-line" aria-hidden="true"></i></span>
            <span class="service-number">04</span>
          </div>
          <h3>Automatización y reportes avanzados</h3>
          <ul class="service-list">
            <li>Generación de reportes en Excel (openpyxl)</li>
            <li>Procesamiento de datos con pandas</li>
            <li>Tareas programadas y sincronización</li>
            <li>Integración con sistemas externos</li>
          </ul>
        </article>

        <article class="service-card" data-reveal style="--reveal-delay: 80ms">
          <div class="service-head">
            <span class="icon-tile"><i class="fa-solid fa-microchip" aria-hidden="true"></i></span>
            <span class="service-number">05</span>
          </div>
          <h3>Integración con hardware</h3>
          <ul class="service-list">
            <li>Integración de protocolos Modbus</li>
            <li>Conexión entre sistemas físicos y web</li>
            <li>Sincronización de datos en tiempo real</li>
            <li>APIs de terceros integradas</li>
          </ul>
        </article>

        <article class="service-card" data-reveal style="--reveal-delay: 160ms">
          <div class="service-head">
            <span class="icon-tile"><i class="fa-solid fa-sitemap" aria-hidden="true"></i></span>
            <span class="service-number">06</span>
          </div>
          <h3>Asesoría arquitectónica</h3>
          <ul class="service-list">
            <li>Diseño de arquitectura escalable</li>
            <li>Análisis del dominio del negocio</li>
            <li>Estrategia técnica a largo plazo</li>
            <li>Evaluación de alternativas técnicas</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- Stack Tecnológico -->
  <section class="section stack" id="stack">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Stack</span>
        <h2 class="section-title">Herramientas con las que trabajo</h2>
        <p class="section-lead">
          Un stack enfocado en estabilidad, rendimiento y mantenimiento a largo
          plazo.
        </p>
      </div>

      <div class="stack-grid">
        <div class="stack-card card" data-reveal>
          <div class="stack-head">
            <span class="icon-tile"><i class="fa-solid fa-server" aria-hidden="true"></i></span>
            <h3>Backend</h3>
          </div>
          <div class="stack-items">
            <span class="chip">Python</span>
            <span class="chip">Django</span>
            <span class="chip">Django REST Framework</span>
            <span class="chip">PostgreSQL</span>
          </div>
        </div>

        <div class="stack-card card" data-reveal style="--reveal-delay: 80ms">
          <div class="stack-head">
            <span class="icon-tile"><i class="fa-solid fa-window-maximize" aria-hidden="true"></i></span>
            <h3>Frontend</h3>
          </div>
          <div class="stack-items">
            <span class="chip">Vue.js</span>
            <span class="chip">HTMX</span>
            <span class="chip">Bootstrap</span>
            <span class="chip">jQuery</span>
          </div>
        </div>

        <div class="stack-card card" data-reveal style="--reveal-delay: 160ms">
          <div class="stack-head">
            <span class="icon-tile"><i class="fa-brands fa-linux" aria-hidden="true"></i></span>
            <h3>Infraestructura</h3>
          </div>
          <div class="stack-items">
            <span class="chip">Linux (Fedora / Debian)</span>
            <span class="chip">Podman & containers</span>
            <span class="chip">SSL / TLS</span>
            <span class="chip">CI/CD</span>
          </div>
        </div>

        <div class="stack-card card" data-reveal style="--reveal-delay: 240ms">
          <div class="stack-head">
            <span class="icon-tile"><i class="fa-solid fa-mobile-screen" aria-hidden="true"></i></span>
            <h3>Mobile</h3>
          </div>
          <div class="stack-items">
            <span class="chip">Android (Kotlin)</span>
            <span class="chip">JWT integrado</span>
            <span class="chip">Sincronización backend</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Diferencial -->
  <section class="section difference">
    <div class="container difference-grid">
      <div class="difference-copy" data-reveal>
        <span class="eyebrow">Mi diferencial</span>
        <h2 class="section-title">Pienso en el negocio antes que en el código</h2>
        <p class="section-lead">
          No solo escribo código. Diseño sistemas que reflejan correctamente la
          lógica real del negocio y evitan inconsistencias futuras.
        </p>

        <ul class="difference-list">
          <li>
            <i class="fa-solid fa-check" aria-hidden="true"></i>
            <span>Análisis profundo del dominio antes de programar</span>
          </li>
          <li>
            <i class="fa-solid fa-check" aria-hidden="true"></i>
            <span>Validaciones estrictas para evitar errores financieros o legales</span>
          </li>
          <li>
            <i class="fa-solid fa-check" aria-hidden="true"></i>
            <span>Código estructurado y fácil de mantener</span>
          </li>
          <li>
            <i class="fa-solid fa-check" aria-hidden="true"></i>
            <span>Comunicación clara con el cliente</span>
          </li>
          <li>
            <i class="fa-solid fa-check" aria-hidden="true"></i>
            <span>Entregables documentados y sostenibles</span>
          </li>
        </ul>
      </div>

      <div class="principles" data-reveal style="--reveal-delay: 120ms">
        <div class="principles-head">
          <span class="mono">// principios_de_trabajo</span>
          <span class="principles-dots" aria-hidden="true"><i></i><i></i><i></i></span>
        </div>

        <div class="principles-body">
          <div class="principle">
            <span class="principle-num">01</span>
            <div>
              <strong>Claridad</strong>
              <p>Si el dominio no está claro, el software tampoco lo estará.</p>
            </div>
          </div>
          <div class="principle">
            <span class="principle-num">02</span>
            <div>
              <strong>Consistencia</strong>
              <p>Las reglas se validan en el sistema, no en la memoria de las personas.</p>
            </div>
          </div>
          <div class="principle">
            <span class="principle-num">03</span>
            <div>
              <strong>Trazabilidad</strong>
              <p>Cada operación debe poder explicarse y auditarse.</p>
            </div>
          </div>
          <div class="principle">
            <span class="principle-num">04</span>
            <div>
              <strong>Mantenibilidad</strong>
              <p>El software debe seguir siendo comprensible dentro de cinco años.</p>
            </div>
          </div>
        </div>

        <div class="principles-foot">
          <i class="fa-solid fa-quote-left" aria-hidden="true"></i>
          <p>
            La tecnología cambia. La lógica del negocio, bien modelada, perdura.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Tipos de Clientes -->
  <section class="section clients">
    <div class="container">
      <div class="section-head center" data-reveal>
        <span class="eyebrow">Colaboraciones</span>
        <h2 class="section-title">¿Con quién trabajo?</h2>
        <p class="section-lead">
          Con equipos y organizaciones que necesitan convertir complejidad
          operativa en software confiable.
        </p>
      </div>

      <div class="clients-grid">
        <article class="client-card" data-reveal>
          <span class="icon-tile"><i class="fa-regular fa-building" aria-hidden="true"></i></span>
          <h3>Empresas con procesos técnicos complejos</h3>
          <p>Sistemas que requieren modelado avanzado y validaciones críticas.</p>
        </article>

        <article class="client-card" data-reveal style="--reveal-delay: 80ms">
          <span class="icon-tile"><i class="fa-solid fa-database" aria-hidden="true"></i></span>
          <h3>Organizaciones con grandes volúmenes de datos</h3>
          <p>Soluciones escalables para procesar y gestionar información masiva.</p>
        </article>

        <article class="client-card" data-reveal style="--reveal-delay: 160ms">
          <span class="icon-tile"><i class="fa-solid fa-code-branch" aria-hidden="true"></i></span>
          <h3>Proyectos con reglas de negocio estrictas</h3>
          <p>Implementación precisa de lógica compleja sin fallos operacionales.</p>
        </article>

        <article class="client-card" data-reveal style="--reveal-delay: 240ms">
          <span class="icon-tile"><i class="fa-solid fa-rocket" aria-hidden="true"></i></span>
          <h3>Startups que necesitan una base sólida</h3>
          <p>Arquitectura escalable desde el inicio para crecer sin deuda técnica.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- CTA Final -->
  <section class="section cta-section">
    <div class="container">
      <div class="cta-panel" data-reveal>
        <div class="cta-glow" aria-hidden="true"></div>
        <span class="eyebrow">Siguiente paso</span>
        <h2 class="cta-title">¿Tu empresa enfrenta desafíos técnicos complejos?</h2>
        <p class="cta-text">
          Hablemos sobre cómo puedo ayudarte a construir sistemas que escalen con
          tu negocio, sin sacrificar claridad ni integridad.
        </p>
        <div class="cta-actions">
          <a
            href="mailto:miltonmce@gmail.com?subject=Solicito%20consultor%C3%ADa%20t%C3%A9cnica"
            class="btn btn-primary"
          >
            <i class="fa-regular fa-paper-plane" aria-hidden="true"></i>
            Solicitar primera consulta
          </a>
          <a href="/cv" class="btn btn-ghost">
            <i class="fa-regular fa-file-lines" aria-hidden="true"></i>
            Conocer mi experiencia
          </a>
        </div>
        <p class="cta-note">Respuesta en menos de 24 horas · Sin compromiso</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ---------- Case study ---------- */
  .case-study {
    background:
      radial-gradient(800px 420px at 100% 0%, rgba(var(--accent-2-rgb), 0.06), transparent 65%),
      var(--bg-soft);
  }

  .case-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: 1.5rem;
    align-items: start;
  }

  .case-content {
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }

  .project-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.8rem;
    border: 1px solid rgba(var(--accent-rgb), 0.22);
    border-radius: 999px;
    background: rgba(var(--accent-rgb), 0.07);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .project-badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px rgba(var(--accent-rgb), 0.14);
  }

  .case-content h3 {
    margin-top: 1.2rem;
    font-size: clamp(1.35rem, 2.4vw, 1.75rem);
    max-width: 620px;
  }

  .case-block {
    margin-top: 1.35rem;
  }

  .case-label {
    margin-bottom: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .case-block p:last-child {
    color: var(--text-soft);
    font-size: 0.94rem;
    line-height: 1.75;
  }

  .impact-box {
    margin-top: 1.5rem;
    padding: 1.25rem;
    border: 1px solid rgba(var(--accent-rgb), 0.14);
    border-left: 2px solid var(--accent);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    background: rgba(var(--accent-rgb), 0.045);
  }

  .impact-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.55rem 1.5rem;
    margin-top: 0.5rem;
    padding: 0;
    list-style: none;
  }

  .impact-list li {
    position: relative;
    padding-left: 1.15rem;
    color: var(--text-soft);
    font-size: 0.84rem;
    line-height: 1.55;
  }

  .impact-list li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1.5rem;
  }

  .case-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
    color: var(--accent);
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
  }

  .case-link i {
    transition: transform 0.25s var(--ease);
  }

  .case-link:hover i {
    transform: translateX(4px);
  }

  .case-side {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    position: sticky;
    top: calc(var(--nav-height) + 1.5rem);
  }

  .stats-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--card-solid);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.35rem 1.5rem;
  }

  .stat + .stat {
    border-top: 1px solid var(--line);
  }

  .stat-number {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 700;
    line-height: 1;
    background: linear-gradient(120deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .stat-label {
    color: var(--text-muted);
    font-size: 0.82rem;
  }

  .flow-card {
    padding: 1.35rem 1.4rem;
  }

  .flow-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .flow-title {
    font-size: 0.86rem;
    font-weight: 600;
  }

  .flow-live {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--success);
    font-family: var(--font-mono);
    font-size: 0.65rem;
  }

  .flow-live span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--success);
    animation: pulse 2.4s ease-in-out infinite;
  }

  .flow-list {
    display: flex;
    flex-direction: column;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .flow-list li {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.8rem 0;
  }

  .flow-list li:not(:last-child)::after {
    content: "";
    position: absolute;
    left: 17px;
    top: 46px;
    width: 1px;
    height: calc(100% - 32px);
    background: linear-gradient(var(--line-strong), transparent);
  }

  .flow-icon {
    display: grid;
    place-items: center;
    flex: 0 0 35px;
    width: 35px;
    height: 35px;
    border: 1px solid var(--line);
    border-radius: 9px;
    background: rgba(255, 255, 255, 0.03);
    color: var(--accent);
    font-size: 0.8rem;
  }

  .flow-list li > span:last-child {
    display: flex;
    flex-direction: column;
    line-height: 1.35;
  }

  .flow-list strong {
    font-size: 0.83rem;
    font-weight: 600;
    color: var(--text);
  }

  .flow-list small {
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  @keyframes pulse {
    0%,
